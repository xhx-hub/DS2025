// 补充文档中定义的Rank类型
typedef size_t Rank;

// 位图类（严格按文档实现）
class Bitmap {
private:
    unsigned char* M;
protected:
    Rank N, _sz; // 位图空间M[], N*sizeof(char)*8个比特中含_sz个有效位
    void init(Rank n);
public:
    Bitmap(Rank n = 8) { init(n); }
    Bitmap(char* file, Rank n = 8) {
        init(n);
        FILE* fp = fopen(file, "r");
        fread(M, sizeof(char), N, fp);
        fclose(fp);
        for (Rank k = 0, _sz = 0; k < n; k++)
            _sz += test(k);
    }
    ~Bitmap() { delete[] M; M = NULL; _sz = 0; }
    Rank size() { return _sz; }
    void set(Rank k);
    void clear(Rank k);
    bool test(Rank k);
    void dump(char* file);
    char* bits2string(Rank n);
private:
    void expand(Rank k);
};

void Bitmap::init(Rank n) {
    M = new unsigned char[N = (n + 7) / 8];
    memset(M, 0, N);
    _sz = 0;
}

void Bitmap::expand(Rank k) {
    if (k < 8 * N) return;
    Rank oldN = N;
    unsigned char* oldM = M;
    init(2 * k); // 按文档要求的加倍策略
    memcpy_s(M, N, oldM, oldN);
    delete[] oldM;
}

void Bitmap::set(Rank k) {
    expand(k);
    _sz++;
    M[k >> 3] |= (0x80 >> (k & 0x07));
}

void Bitmap::clear(Rank k) {
    expand(k);
    _sz--;
    M[k >> 3] &= ~(0x80 >> (k & 0x07));
}

bool Bitmap::test(Rank k) {
    expand(k);
    return M[k >> 3] & (0x80 >> (k & 0x07));
}

void Bitmap::dump(char* file) {
    FILE* fp = fopen(file, "w");
    fwrite(M, sizeof(char), N, fp);
    fclose(fp);
}

char* Bitmap::bits2string(Rank n) {
    expand(n - 1);
    char* s = new char[n + 1];
    s[n] = '\0';
    for (Rank i = 0; i < n; i++)
        s[i] = test(i) ? '1' : '0';
    return s;
}

// 二叉树节点基类
template <typename T>
class BinNode {
public:
    T data;
    BinNode<T>* left;
    BinNode<T>* right;
    BinNode<T>* parent;

    BinNode(T d = T(), BinNode<T>* l = nullptr, BinNode<T>* r = nullptr, BinNode<T>* p = nullptr)
        : data(d), left(l), right(r), parent(p) {}
    ~BinNode() {}

    bool isLeaf() const { return left == nullptr && right == nullptr; }
};

// 二叉树类（BinTree）
template <typename T>
class BinTree {
protected:
    BinNode<T>* root;
    size_t _size;

public:
    BinTree() : root(nullptr), _size(0) {}
    ~BinTree() { clear(); }

    size_t size() const { return _size; }
    bool empty() const { return _size == 0; }
    BinNode<T>* getRoot() const { return root; }

    void clear() {
        if (root) {
            destroy(root);
            root = nullptr;
            _size = 0;
        }
    }

protected:
    void destroy(BinNode<T>* node) {
        if (node == nullptr) return;
        destroy(node->left);
        destroy(node->right);
        delete node;
    }
};

// Huffman树节点数据结构
struct HuffNodeData {
    char ch;
    int frequency;
    HuffNodeData(char c = '\0', int f = 0) : ch(c), frequency(f) {}
};

// Huffman树类（基于BinTree）
class HuffTree : public BinTree<HuffNodeData> {
public:
    HuffTree(char chs[], int freqs[], int n) {
        auto cmp = [](BinNode<HuffNodeData>* a, BinNode<HuffNodeData>* b) {
            return a->data.frequency > b->data.frequency;
        };
        priority_queue<BinNode<HuffNodeData>*, vector<BinNode<HuffNodeData>*>, decltype(cmp)> minHeap(cmp);

        // 创建叶子节点
        for (int i = 0; i < n; i++) {
            if (freqs[i] > 0) {
                BinNode<HuffNodeData>* leaf = new BinNode<HuffNodeData>(HuffNodeData(chs[i], freqs[i]));
                minHeap.push(leaf);
                _size++;
            }
        }

        // 构建Huffman树
        while (minHeap.size() > 1) {
            BinNode<HuffNodeData>* left = minHeap.top(); minHeap.pop();
            BinNode<HuffNodeData>* right = minHeap.top(); minHeap.pop();

            BinNode<HuffNodeData>* parent = new BinNode<HuffNodeData>(
                HuffNodeData('\0', left->data.frequency + right->data.frequency),
                left, right
            );
            left->parent = parent;
            right->parent = parent;

            minHeap.push(parent);
            _size++;
        }

        root = minHeap.empty() ? nullptr : minHeap.top();
    }
};

// Huffman编码类（基于Bitmap）
class HuffCode {
private:
    Bitmap bits;
    size_t length;
public:
    HuffCode() : length(0) {}
    ~HuffCode() {}

    void appendBit(bool isOne) {
        if (isOne) bits.set(length);
        else bits.clear(length);
        length++;
    }

    char* toString() {
        return bits.bits2string(length);
    }

    size_t getLength() const { return length; }

    // 用于回溯的清除位操作
    void clearBit(size_t k) {
        if (k < length) {
            bits.clear(k);
        }
    }
};

// Huffman编码器
class HuffEncoder {
private:
    HuffCode codeTable[26];
    HuffTree* huffTree;

public:
    HuffEncoder() {
        // 《I have a dream》演讲原文
        const char* speech = "I have a dream that one day this nation will rise up and live out the true meaning of its creed "
                            "We hold these truths to be self-evident that all men are created equal "
                            "I have a dream that one day on the red hills of Georgia the sons of former slaves and the sons of former slave owners will be able to sit down together at the table of brotherhood "
                            "I have a dream that one day even the state of Mississippi a state sweltering with the heat of injustice sweltering with the heat of oppression will be transformed into an oasis of freedom and justice "
                            "I have a dream that my four little children will one day live in a nation where they will not be judged by the color of their skin but by the content of their character "
                            "I have a dream today "
                            "I have a dream that one day down in Alabama with its vicious racists with its governor having his lips dripping with the words of interposition and nullification one day right there in Alabama little black boys and black girls will be able to join hands with little white boys and white girls as sisters and brothers "
                            "I have a dream today "
                            "I have a dream that one day every valley shall be exalted and every hill and mountain shall be made low the rough places will be made plain and the crooked places will be made straight and the glory of the Lord shall be revealed and all flesh shall see it together";

        int freqs[26] = {0};
        char chs[26];
        for (int i = 0; i < 26; i++) {
            chs[i] = 'a' + i;
        }

        // 统计26个字母频率（不分大小写）
        for (const char* p = speech; *p != '\0'; p++) {
            if (isalpha(*p)) {
                char c = tolower(*p);
                freqs[c - 'a']++;
            }
        }

        // 构建Huffman树
        huffTree = new HuffTree(chs, freqs, 26);

        // 构建编码表
        HuffCode emptyCode;
        buildCodeTable(huffTree->getRoot(), emptyCode);
    }

    ~HuffEncoder() {
        delete huffTree;
    }

    // 单词编码
    HuffCode encodeWord(const char* word) {
        HuffCode result;
        for (const char* p = word; *p != '\0'; p++) {
            if (isalpha(*p)) {
                char c = tolower(*p);
                int idx = c - 'a';
                HuffCode& charCode = codeTable[idx];
                char* codeStr = charCode.toString();
                for (size_t i = 0; i < charCode.getLength(); i++) {
                    result.appendBit(codeStr[i] == '1');
                }
                delete[] codeStr;
            }
        }
        return result;
    }

    // 打印编码表
    void printCodeTable() {
        cout << "Huffman编码表（a-z）：" << endl;
        for (int i = 0; i < 26; i++) {
            char c = 'a' + i;
            char* code = codeTable[i].toString();
            cout << c << " : " << code << " (长度：" << codeTable[i].getLength() << ")" << endl;
            delete[] code;
        }
    }

private:
    // 递归构建编码表
    void buildCodeTable(BinNode<HuffNodeData>* node, HuffCode currentCode) {
        if (node == nullptr) return;

        // 叶子节点：记录编码
        if (node->isLeaf()) {
            char c = node->data.ch;
            if (isalpha(c)) {
                int idx = tolower(c) - 'a';
                codeTable[idx] = currentCode;
            }
            return;
        }

        // 左子树：追加0
        currentCode.appendBit(false);
        buildCodeTable(node->left, currentCode);
        currentCode.clearBit(currentCode.getLength() - 1);

        // 右子树：追加1
        currentCode.appendBit(true);
        buildCodeTable(node->right, currentCode);
        currentCode.clearBit(currentCode.getLength() - 1);
    }
};

// 测试主函数
int main() {
    HuffEncoder encoder;

    // 打印编码表
    encoder.printCodeTable();

    // 测试编码单词
    const char* testWords[] = {"dream", "freedom", "justice", "equality", "brotherhood", "nation", "hope"};
    int wordCount = sizeof(testWords) / sizeof(testWords[0]);

    cout << "\n测试单词编码结果：" << endl;
    for (int i = 0; i < wordCount; i++) {
        HuffCode code = encoder.encodeWord(testWords[i]);
        char* codeStr = code.toString();
        cout << testWords[i] << " : " << codeStr << " (长度：" << code.getLength() << "比特)" << endl;
        delete[] codeStr;
    }

    return 0;
}
